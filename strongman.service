[Unit]
Description=Strongman Competition Engine
After=network.target

[Service]
Type=simple
User=strongman
WorkingDirectory=/opt/strongman
ExecStart=/opt/strongman/venv/bin/gunicorn -c gunicorn.conf.py server:app
Restart=always
RestartSec=5

# Set COMP_PASSWORD to protect the admin interface
# Set PROXY_ALLOWLIST to restrict the proxy endpoint (comma-separated domains)
Environment="COMP_PASSWORD=changeme"
Environment="PROXY_ALLOWLIST="

StandardOutput=journal
StandardError=journal
SyslogIdentifier=strongman

[Install]
WantedBy=multi-user.target
