[Unit]
Description=Strongman Competition Engine
After=network.target

[Service]
Type=simple
User=strongman
WorkingDirectory=/opt/strongman
ExecStart=/opt/strongman/venv/bin/gunicorn -c gunicorn.conf.py server:app
Restart=always
RestartSec=5

# ── Beta access gate ──────────────────────────────────────────────────────────
# BETA_TOKEN: shared password for sitewide access. Unset or leave blank to
#   disable the gate entirely (no deploy required — just restart).
# SECRET_KEY: Flask session signing key. If unset, derived from BETA_TOKEN.
#   Set explicitly if you want session cookies to survive a BETA_TOKEN rotation.
Environment="BETA_TOKEN=changeme"
Environment="SECRET_KEY="

# ── Competition admin ──────────────────────────────────────────────────────────
# COMP_PASSWORD: password for the /comp/* admin interface (on top of BETA_TOKEN).
Environment="COMP_PASSWORD=changeme"

# ── External API proxy ────────────────────────────────────────────────────────
# PROXY_ALLOWLIST: comma-separated domains permitted for /proxy (blank = allow all)
Environment="PROXY_ALLOWLIST="

StandardOutput=journal
StandardError=journal
SyslogIdentifier=strongman

[Install]
WantedBy=multi-user.target
